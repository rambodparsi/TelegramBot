{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tg-assistant",
  "main": "src/entry.py",
  // Matches the official langgraph-checkpoint-cloudflare-d1 example; bump only with a test run.
  "compatibility_date": "2025-11-02",
  "compatibility_flags": ["python_workers"],
  "observability": { "enabled": true },
  "workers_dev": true,

  // Bindings are NOT inherited by environments, so each env declares its own.
  "env": {
    "staging": {
      "name": "tg-assistant-staging",
      "vars": {
        "APP_ENV": "staging",
        "DEFAULT_TIMEZONE": "America/Chicago",
        "MODEL_CHAT": "gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite",
        "MODEL_VISION": "gemini-3.5-flash,gemini-3.5-flash-lite",
        "MODEL_TRANSCRIBE": "gemini-3.5-transcribe,gemini-3.5-flash-lite",
        "MODEL_LIGHT": "gemini-3.5-flash-lite,gemini-3.1-flash-lite",
        "MODEL_DEEP": "gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "tg-assistant-staging",
          "database_id": "68b4b2a6-0901-40af-a23e-b6301eb5b81a",
          "migrations_dir": "migrations"
        }
      ]
    },
    "production": {
      "name": "tg-assistant",
      "vars": {
        "APP_ENV": "production",
        "DEFAULT_TIMEZONE": "America/Chicago",
        "MODEL_CHAT": "gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite",
        "MODEL_VISION": "gemini-3.5-flash,gemini-3.5-flash-lite",
        "MODEL_TRANSCRIBE": "gemini-3.5-transcribe,gemini-3.5-flash-lite",
        "MODEL_LIGHT": "gemini-3.5-flash-lite,gemini-3.1-flash-lite",
        "MODEL_DEEP": "gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "tg-assistant-prod",
          "database_id": "ba28e46e-4860-448d-b693-1fe18ef3842a",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
