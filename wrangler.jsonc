{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tg-assistant",
  "main": "src/entry.py",
  // Matches the official langgraph-checkpoint-cloudflare-d1 example; bump only with a test run.
  "compatibility_date": "2025-11-02",
  "compatibility_flags": ["python_workers"],
  "observability": { "enabled": true },
  "workers_dev": true,

  // Bindings are NOT inherited by environments, so each env declares its own.
  "env": {
    "staging": {
      "name": "tg-assistant-staging",
      "vars": {
        "APP_ENV": "staging",
        // Planner (Google Sheet). Staging MUST use the Planner-TEST copy.
        "PLANNER_SHEET_ID": "1Gx8U43J7hXYXLNzcZREKkBcznAO1CDb55EfMXoCPHos",
        "DEFAULT_TIMEZONE": "America/Chicago",
        "MAX_MEDIA_MB": "10",
        "MODEL_CHAT": "gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite",
        "MODEL_VISION": "gemini-3.5-flash,gemini-3.5-flash-lite",
        "MODEL_TRANSCRIBE": "gemini-3.5-transcribe,gemini-3.5-flash-lite",
        "MODEL_LIGHT": "gemini-3.5-flash-lite,gemini-3.1-flash-lite",
        "MODEL_DEEP": "gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash",
        "MODEL_SEARCH": "gemini-3.5-flash,gemini-3.5-flash-lite",
        // tavily | gemini (Google Search grounding; needs quota) | auto (gemini, then tavily)
        "SEARCH_PROVIDER": "tavily"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "tg-assistant-staging",
          "database_id": "68b4b2a6-0901-40af-a23e-b6301eb5b81a",
          "migrations_dir": "migrations"
        }
      ],
      "queues": {
        "producers": [{ "binding": "MESSAGE_QUEUE", "queue": "tg-assistant-staging-jobs" }],
        "consumers": [{
          "queue": "tg-assistant-staging-jobs",
          "max_batch_size": 1,          // one update at a time: keeps a chat's messages in order
          "max_batch_timeout": 0,
          "max_concurrency": 1,
          "max_retries": 3,             // keep in sync with MAX_ATTEMPTS in src/entry.py
          "dead_letter_queue": "tg-assistant-staging-dlq"
        }]
      },
      "triggers": { "crons": ["17 9 * * *"] }
    },
    "production": {
      "name": "tg-assistant",
      "vars": {
        "APP_ENV": "production",
        // Planner (Google Sheet). Empty = planner off. Real sheet: 1GLngCyjfs5S8bH0lArXsqw3VZdJXhR2SZtZw4bFNOjo
        "PLANNER_SHEET_ID": "",
        "DEFAULT_TIMEZONE": "America/Chicago",
        "MAX_MEDIA_MB": "10",
        "MODEL_CHAT": "gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite",
        "MODEL_VISION": "gemini-3.5-flash,gemini-3.5-flash-lite",
        "MODEL_TRANSCRIBE": "gemini-3.5-transcribe,gemini-3.5-flash-lite",
        "MODEL_LIGHT": "gemini-3.5-flash-lite,gemini-3.1-flash-lite",
        "MODEL_DEEP": "gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash",
        "MODEL_SEARCH": "gemini-3.5-flash,gemini-3.5-flash-lite",
        // tavily | gemini (Google Search grounding; needs quota) | auto (gemini, then tavily)
        "SEARCH_PROVIDER": "tavily"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "tg-assistant-prod",
          "database_id": "ba28e46e-4860-448d-b693-1fe18ef3842a",
          "migrations_dir": "migrations"
        }
      ],
      "queues": {
        "producers": [{ "binding": "MESSAGE_QUEUE", "queue": "tg-assistant-jobs" }],
        "consumers": [{
          "queue": "tg-assistant-jobs",
          "max_batch_size": 1,          // one update at a time: keeps a chat's messages in order
          "max_batch_timeout": 0,
          "max_concurrency": 1,
          "max_retries": 3,             // keep in sync with MAX_ATTEMPTS in src/entry.py
          "dead_letter_queue": "tg-assistant-dlq"
        }]
      },
      "triggers": { "crons": ["17 9 * * *"] }
    }
  }
}
